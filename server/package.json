{
  "name": "doroom-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DOROOM 백엔드 (Express + PostgreSQL)",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:init": "node scripts/dbInit.js",
    "db:reset": "node scripts/dbInit.js --reset",
    "batch:daily": "node src/batch/dailyHunger.js",
    "batch:weekly": "node src/batch/weeklyRanking.js",
    "smoke": "node scripts/smoke.js",
    "dev:grant-pet": "node scripts/devGrantPet.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
